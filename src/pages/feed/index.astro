---
// /feed/ — the full activity feed: every recent public commit plus every
// hand-written note, newest first. The home page carries a capped teaser of
// the same list (see the #feed section in src/pages/index.astro).
//
// The GitHub request happens here, at build time, on the machine running the
// build — never in a visitor's browser. See src/lib/github.ts for why that
// distinction matters, and for the contract that a GitHub outage empties this
// page rather than failing the build.
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeedList from '../../components/FeedList.astro';
import { pageMeta } from '../../data/meta';
import { feed } from '../../data/site';
import { buildFeed } from '../../lib/feed';

const items = await buildFeed();
---

<BaseLayout title={pageMeta.feed.title} description={pageMeta.feed.description}>
  <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
    <p data-animate="section" class="text-micro text-accent-ink">{feed.eyebrow}</p>
    <h1 data-animate="section" class="text-display mt-2 text-text">{feed.h1}</h1>
    <p data-animate="section" class="prose-measure mt-6 text-text-muted">{feed.intro}</p>

    <FeedList items={items} />

    {
      items.length === 0 && (
        <p data-animate="section" class="prose-measure mt-10 text-text-muted">
          {feed.emptyState}
        </p>
      )
    }
  </section>
</BaseLayout>
