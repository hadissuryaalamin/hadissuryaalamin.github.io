---
// Home page (epic.md §5.1). Sections in order: hero, about, selected
// projects, other work, feed, contact. This replaces the task-002
// placeholder entirely.
//
// The feed teaser sits between other work and contact so the page reads
// "selected work → other work → what I'm doing now → get in touch".
//
// The teaser and /feed/ show the same list, just cut to different lengths —
// which repositories belong in the feed at all is decided once, by the
// filters in src/data/feed.ts (coursework is excluded there, keeping this
// page clear of it per criterion 24).
//
// The GitHub request happens at build time — see src/lib/github.ts for the
// contract that an outage empties the section rather than failing the build.
import Hero from '../components/Hero.astro';
import FeedList from '../components/FeedList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about, contact, feed, identity, otherWorkHeading } from '../data/site';
import { pageMeta } from '../data/meta';
import { featuredProjects, otherWork } from '../data/projects';
import { buildFeed } from '../lib/feed';

const feedTeaser = await buildFeed(5);
---

<BaseLayout title={pageMeta.home.title} description={pageMeta.home.description}>
  <Hero />

  <section class="mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
    <p data-animate="section" class="text-micro text-accent-ink">Background</p>
    <h2 data-animate="section" class="text-h2 mt-2 text-text">About</h2>
    <div class="prose-measure mt-6 flex flex-col gap-4">
      {about.map((paragraph) => <p data-animate="section" class="text-text-muted">{paragraph}</p>)}
    </div>
  </section>

  <section id="projects" class="hairline mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
    <p data-animate="section" class="text-micro text-accent-ink">Selected work</p>
    <h2 data-animate="section" class="text-h2 mt-2 text-text">Projects</h2>
    <ul data-animate-stagger class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        featuredProjects.map((project) => (
          <ProjectCard project={project} featured={project.order === 1} />
        ))
      }
    </ul>
  </section>

  <section class="hairline mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
    <h2 data-animate="section" class="text-h2 text-text">{otherWorkHeading}</h2>
    <ul class="prose-measure mt-6 flex flex-col gap-3">
      {
        otherWork.map((item) => (
          <li data-animate="section" class="text-text-muted">
            {item.href ? (
              <a href={item.href} class="link-accent font-medium" rel="noopener">
                {item.name}
              </a>
            ) : (
              <span class="font-medium text-text">{item.name}</span>
            )}{' '}
            — {item.summary}
          </li>
        ))
      }
    </ul>
  </section>

  {
    feedTeaser.length > 0 && (
      <section id="feed" class="hairline mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
        <p data-animate="section" class="text-micro text-accent-ink">
          {feed.eyebrow}
        </p>
        <h2 data-animate="section" class="text-h2 mt-2 text-text">
          {feed.heading}
        </h2>
        <FeedList items={feedTeaser} />
        <div data-animate="section" class="mt-8">
          <a href="/feed/" class="link-quiet text-sm font-medium">
            {feed.viewAllLabel}
          </a>
        </div>
      </section>
    )
  }

  <section id="contact" class="hairline mx-auto max-w-6xl px-6 py-16 md:px-8 md:py-24 xl:px-12">
    <p data-animate="section" class="text-micro text-accent-ink">Get in touch</p>
    <h2 data-animate="section" class="text-h2 mt-2 text-text">{contact.heading}</h2>
    <p data-animate="section" class="prose-measure mt-6 text-text-muted">
      {contact.paragraphPrefix}{' '}
      <a href={identity.emailHref} class="link-accent font-medium">
        {contact.emailText}
      </a>.
    </p>
    <p data-animate="section" class="mt-2 text-sm text-text-muted">
      {contact.paragraphSuffix.replace(/^\.\s*/, '')}{' '}
      <a href={identity.linkedin} class="link-accent text-sm font-medium" rel="noopener">
        {contact.linkedinLabel}
      </a>.
    </p>
    <div data-animate="section" class="mt-8">
      <a href={contact.ctaPrimary.href} class="btn-primary">{contact.ctaPrimary.label}</a>
    </div>
  </section>
</BaseLayout>
