{
  "extends": "stylelint-config-standard",
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["tailwind", "theme", "utility", "custom-variant", "apply", "layer", "variant", "responsive", "screen", "reference"]
      }
    ],
    "import-notation": "string"
  }
}
